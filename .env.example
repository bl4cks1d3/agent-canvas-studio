# Agent Canvas - copie para .env e preencha ao menos UMA chave de IA.
# Os agentes do canvas escolhem o provedor: "auto" usa a primeira chave abaixo que existir.

# Voce tambem pode cadastrar chaves e modelos pela aba "Configuracoes" do app (grava neste .env e vale na hora).
# AI_PROVIDER: qual provedor o modo "auto" tenta primeiro (groq, gemini ou anthropic; vazio = groq, gemini, anthropic).
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Portas (incomuns de proposito). Terminal escuta SO em 127.0.0.1.
# SERVER_HOST: onde a API escuta (padrao 127.0.0.1: so esta maquina; a API nao tem senha). Para outro computador use tunel SSH.
SERVER_HOST=127.0.0.1
SERVER_PORT=5100
WEB_PORT=5200
TERMINAL_PORT=5300
TERMINAL_ALLOWED_ORIGINS=
# Voz no terminal do Claude Code (/voice do proprio Claude Code, com o microfone DESTA maquina; exige conta claude.ai):
# tap = tocar no Espaco para gravar e de novo para enviar (padrao) | hold = segurar o Espaco | off = nao ativar.
# TERMINAL_VOICE_LANGUAGE: idioma do ditado e das respostas (padrao pt; vazio = nao define).
TERMINAL_VOICE=tap
TERMINAL_VOICE_LANGUAGE=pt

# No "Claude Code" do canvas (claude -p): ferramentas que ele pode usar sem perguntar.
# Bash so com CLAUDE_NODE_ALLOW_BASH=true (executa comandos no seu PC: ligue so se souber o que faz).
CLAUDE_NODE_ALLOW_BASH=false

# Conta Google (Agenda/Gmail/Tasks): o botao "Conectar conta Google" da Biblioteca preenche estas 3 linhas para voce.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=

# URLs para o navegador falar com cada servico (so mude se nao for localhost).
NEXT_PUBLIC_SERVER_URL=http://localhost:5100
NEXT_PUBLIC_TERMINAL_URL=http://127.0.0.1:5300
