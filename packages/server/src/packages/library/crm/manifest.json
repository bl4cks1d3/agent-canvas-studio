{
  "id": "crm",
  "name": "CRM",
  "description": "Funil de vendas com arrastar-e-soltar, base de contatos e indicadores. Um analista de IA sugere os próximos follow-ups.",
  "category": "vendas",
  "version": "1.0.0",
  "requires": [
    {
      "id": "negocios",
      "kind": "collection",
      "label": "Coleção crm_negocios (criada na instalação)",
      "collection": "crm_negocios"
    },
    {
      "id": "contatos",
      "kind": "collection",
      "label": "Coleção crm_contatos (criada na instalação)",
      "collection": "crm_contatos"
    },
    {
      "id": "ia",
      "kind": "ai",
      "label": "Provedor de IA (para o botão “Perguntar à IA”)",
      "optional": true
    }
  ],
  "collections": [
    {
      "name": "crm_contatos",
      "label": "Contatos do CRM",
      "description": "Pessoas e empresas com quem você negocia.",
      "fields": [
        { "name": "nome", "label": "Nome", "type": "text", "required": true },
        { "name": "empresa", "label": "Empresa", "type": "text" },
        { "name": "email", "label": "E-mail", "type": "text" },
        { "name": "telefone", "label": "Telefone", "type": "text" },
        {
          "name": "origem",
          "label": "Origem",
          "type": "select",
          "options": ["indicacao", "site", "evento", "redes-sociais", "prospeccao", "outro"]
        },
        { "name": "notas", "label": "Notas", "type": "longtext" }
      ]
    },
    {
      "name": "crm_negocios",
      "label": "Negócios do CRM",
      "description": "Cada oportunidade de venda; a etapa define a coluna do funil.",
      "fields": [
        { "name": "titulo", "label": "Título", "type": "text", "required": true },
        { "name": "contato", "label": "Contato (nome)", "type": "text" },
        { "name": "valor", "label": "Valor (R$)", "type": "number" },
        {
          "name": "etapa",
          "label": "Etapa",
          "type": "select",
          "options": ["lead", "contato", "proposta", "negociacao", "ganho", "perdido"]
        },
        { "name": "fechamento", "label": "Fechamento previsto", "type": "date" },
        { "name": "notas", "label": "Notas", "type": "longtext" }
      ]
    }
  ],
  "blocks": [
    {
      "key": "kpis",
      "name": "CRM: indicadores",
      "description": "Valor em aberto, valor ganho, taxa de conversão e negócios por etapa.",
      "htmlFile": "kpis.html",
      "cssFile": "kpis.css",
      "jsFile": "kpis.js",
      "refreshSeconds": 30,
      "permissions": {
        "read": ["col:crm_negocios", "col:crm_contatos"],
        "write": [],
        "tools": [],
        "agents": []
      }
    },
    {
      "key": "funil",
      "name": "CRM: funil de negócios",
      "description": "Negócios por etapa com arrastar-e-soltar, totais por coluna e pergunta à IA.",
      "htmlFile": "funil.html",
      "cssFile": "funil.css",
      "jsFile": "funil.js",
      "refreshSeconds": 30,
      "permissions": {
        "read": ["col:crm_negocios", "col:crm_contatos"],
        "write": ["col:crm_negocios"],
        "tools": [],
        "agents": ["analista"]
      }
    },
    {
      "key": "contatos",
      "name": "CRM: contatos",
      "description": "Lista de contatos com busca, cadastro e quantidade de negócios de cada um.",
      "htmlFile": "contatos.html",
      "cssFile": "contatos.css",
      "jsFile": "contatos.js",
      "refreshSeconds": 30,
      "permissions": {
        "read": ["col:crm_contatos", "col:crm_negocios"],
        "write": ["col:crm_contatos", "col:crm_negocios"],
        "tools": [],
        "agents": []
      }
    }
  ],
  "canvases": [
    {
      "key": "analista",
      "name": "CRM: analista",
      "description": "Lê negócios e contatos e responde a uma pergunta ou sugere os próximos follow-ups (o campo “Perguntar à IA” do funil executa este canvas).",
      "nodes": [
        {
          "id": "pedido",
          "type": "input.prompt",
          "name": "Pergunta",
          "x": 0,
          "y": 60,
          "config": {
            "text": "Quais negócios precisam de follow-up esta semana e por quê?"
          }
        },
        {
          "id": "analista",
          "type": "agent.llm",
          "name": "Analista de vendas",
          "x": 320,
          "y": 40,
          "config": {
            "provider": "auto",
            "instructions": "Você é um analista de vendas de um CRM. Hoje é {{now.date}}. Os dados ficam em duas coleções: crm_negocios (campos titulo, contato = nome do contato, valor em reais, etapa = lead|contato|proposta|negociacao|ganho|perdido, fechamento = data prevista AAAA-MM-DD, notas) e crm_contatos (nome, empresa, email, telefone, origem, notas). Antes de responder, chame list_records para crm_negocios e para crm_contatos. Considere em aberto as etapas lead, contato, proposta e negociacao; ganho e perdido são encerradas. Responda em português do Brasil, de forma direta, com no máximo 8 linhas ou tópicos: cite o título do negócio, o contato, o valor e a razão de cada sugestão (fechamento vencido ou próximo, valor alto, etapa parada). Se a mensagem for uma pergunta específica, responda a ela usando os dados; se pedir algo genérico, liste os próximos follow-ups em ordem de prioridade. Escreva em texto simples, sem markdown (nada de asteriscos ou #), usando \"- \" para os tópicos. Não invente dados e não altere nenhum registro.",
            "tools": ["list_records"],
            "maxSteps": 6
          }
        },
        {
          "id": "resultado",
          "type": "output.result",
          "name": "Análise",
          "x": 660,
          "y": 60,
          "config": {
            "title": "Análise do funil"
          }
        }
      ],
      "edges": [
        { "id": "pedido_main_analista", "from": "pedido", "fromPort": "main", "to": "analista" },
        { "id": "analista_main_resultado", "from": "analista", "fromPort": "main", "to": "resultado" }
      ]
    }
  ],
