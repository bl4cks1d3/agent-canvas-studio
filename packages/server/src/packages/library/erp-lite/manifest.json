{
  "id": "erp-lite",
  "name": "ERP leve",
  "description": "Produtos, estoque e pedidos com indicadores de faturamento. O estoque baixa ao criar um pedido e volta ao cancelar; um agente sugere a reposição.",
  "category": "negócios",
  "version": "1.0.0",
  "requires": [
    {
      "id": "produtos",
      "kind": "collection",
      "label": "Coleção erp_produtos (criada na instalação)",
      "collection": "erp_produtos"
    },
    {
      "id": "pedidos",
      "kind": "collection",
      "label": "Coleção erp_pedidos (criada na instalação)",
      "collection": "erp_pedidos"
    },
    {
      "id": "ia",
      "kind": "ai",
      "label": "Provedor de IA (para o botão “Sugerir reposição”)",
      "optional": true
    }
  ],
  "collections": [
    {
      "name": "erp_produtos",
      "label": "Produtos do ERP",
      "description": "Catálogo com preço e estoque.",
      "fields": [
        { "name": "nome", "label": "Nome", "type": "text", "required": true },
        { "name": "sku", "label": "SKU", "type": "text" },
        { "name": "preco", "label": "Preço (R$)", "type": "number" },
        { "name": "estoque", "label": "Estoque", "type": "number" },
        { "name": "minimo", "label": "Estoque mínimo", "type": "number" }
      ]
    },
    {
      "name": "erp_pedidos",
      "label": "Pedidos do ERP",
      "description": "Cada pedido de um cliente para um produto.",
      "fields": [
        { "name": "cliente", "label": "Cliente", "type": "text", "required": true },
        { "name": "produto", "label": "Produto (nome)", "type": "text", "required": true },
        { "name": "quantidade", "label": "Quantidade", "type": "number", "required": true },
        { "name": "total", "label": "Total (R$)", "type": "number" },
        {
          "name": "status",
          "label": "Status",
          "type": "select",
          "options": ["aberto", "pago", "enviado", "cancelado"]
        },
        { "name": "data", "label": "Data", "type": "date" }
      ]
    }
  ],
  "blocks": [
    {
      "key": "kpis",
      "name": "ERP: indicadores",
      "description": "Faturamento, pedidos em aberto, produtos abaixo do mínimo e os mais vendidos.",
      "htmlFile": "kpis.html",
      "cssFile": "kpis.css",
      "jsFile": "kpis.js",
      "refreshSeconds": 30,
      "permissions": {
        "read": ["col:erp_produtos", "col:erp_pedidos"],
        "write": [],
        "tools": [],
        "agents": []
      }
    },
    {
      "key": "produtos",
      "name": "ERP: produtos e estoque",
      "description": "Tabela de produtos com ajuste rápido de estoque e destaque do que está abaixo do mínimo.",
      "htmlFile": "produtos.html",
      "cssFile": "produtos.css",
      "jsFile": "produtos.js",
      "refreshSeconds": 20,
      "permissions": {
        "read": ["col:erp_produtos", "col:erp_pedidos"],
        "write": ["col:erp_produtos", "col:erp_pedidos"],
        "tools": [],
        "agents": ["reposicao"]
      }
    },
    {
      "key": "pedidos",
      "name": "ERP: pedidos",
      "description": "Pedidos com criação (baixa o estoque), troca de status (cancelar devolve o estoque) e exclusão.",
      "htmlFile": "pedidos.html",
      "cssFile": "pedidos.css",
      "jsFile": "pedidos.js",
      "refreshSeconds": 20,
      "permissions": {
        "read": ["col:erp_pedidos", "col:erp_produtos"],
        "write": ["col:erp_pedidos", "col:erp_produtos"],
        "tools": [],
        "agents": []
      }
    }
  ],
  "canvases": [
    {
      "key": "reposicao",
      "name": "ERP: reposição",
      "description": "Lê produtos e pedidos e propõe a lista de reposição de estoque (o botão “Sugerir reposição” da tabela de produtos executa este canvas).",
      "nodes": [
        {
          "id": "pedido",
          "type": "input.prompt",
          "name": "Pedido",
          "x": 0,
          "y": 60,
          "config": {
            "text": "Monte a lista de reposição de estoque."
          }
        },
        {
          "id": "comprador",
          "type": "agent.llm",
          "name": "Analista de compras",
          "x": 320,
          "y": 40,
          "config": {
            "provider": "auto",
            "instructions": "Você é um analista de compras de uma loja. Hoje é {{now.date}}. Antes de responder, chame list_records para erp_produtos (campos nome, sku, preco, estoque, minimo) e para erp_pedidos (cliente, produto = nome do produto, quantidade, total, status aberto|pago|enviado|cancelado, data). Um produto precisa de reposição quando estoque < minimo, ou quando o estoque menos as unidades dos pedidos com status aberto ficaria abaixo do mínimo. Para cada produto que precisa, proponha uma quantidade de compra = (minimo x 2) - estoque, aumentando quando os pedidos pagos ou enviados mostrarem venda alta, e ignore pedidos cancelados. Ordene do mais urgente (maior falta em relação ao mínimo) para o menos urgente. Responda em português do Brasil, em texto simples, sem markdown (nada de asteriscos ou #), uma linha por produto no formato \"- Nome (SKU): estoque X, mínimo Y, comprar Z un. — motivo curto\". Se nenhum produto precisar, responda apenas \"Nenhum produto precisa de reposição agora.\". Não invente dados e não altere nenhum registro.",
            "tools": ["list_records"],
            "maxSteps": 6
          }
        },
        {
          "id": "resultado",
          "type": "output.result",
          "name": "Lista de reposição",
          "x": 660,
          "y": 60,
          "config": {
            "title": "Lista de reposição"
          }
        }
      ],
      "edges": [
        { "id": "pedido_main_comprador", "from": "pedido", "fromPort": "main", "to": "comprador" },
        { "id": "comprador_main_resultado", "from": "comprador", "fromPort": "main", "to": "resultado" }
      ]
    }
  ],
  "seed": {
