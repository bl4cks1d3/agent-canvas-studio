      "cssFile": "metas.css"
    },
    {
      "key": "flashcards",
      "name": "Flashcards",
      "description": "Cartões de estudo com repetição espaçada: revise só o que vence hoje.",
      "permissions": {
        "read": [
          "col:estudo_cartoes",
          "col:estudo_materias"
        ],
        "write": [
